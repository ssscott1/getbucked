# ---------------------------------------------------------------------
# Buck Me — environment variables
# Copy this file to `.env.local` and fill in real values.
# Find the Supabase values in Supabase → Project Settings → API.
# ---------------------------------------------------------------------

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL — service_role key. The public form works without it via a
# constrained anon insert policy; if set, the insert uses it instead.
# Never import into client code, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED for the /admin CRM. Doubles as the admin login password and the
# secret used to reach the secret-gated admin_* database functions. Must
# match the value stored in the DB (public.admin_config). Generate with:
#   openssl rand -hex 24
ADMIN_SECRET=your-long-random-admin-secret

# ---- New-lead email notifications (optional) ----
# Get a key at https://resend.com (free tier). Without it, notifications are
# skipped (lead capture still works). To send from the default onboarding
# address without verifying a domain, sign up to Resend with the same email
# you set as LEAD_NOTIFY_TO.
RESEND_API_KEY=
LEAD_NOTIFY_TO=scott.iriks@gmail.com
# LEAD_NOTIFY_FROM=Buck Me <onboarding@resend.dev>
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app   # adds a /admin link to the email
